# Swift package build output. build.sh and release.sh build in
# ~/Library/Developer/MacRemote, but a plain `swift build` or Xcode
# opening Package.swift writes these into the repo.
.build/
.swiftpm/
DerivedData/
*.xcodeproj/
*.xcworkspace/
xcuserdata/

# tools/release.sh output (the .app and the zip for other Macs).
/dist/

# Note: Resources/Assets.car and Resources/AppIcon.icns are generated by
# tools/make_icon.sh but stay tracked, so a release builds without actool.

# Signing and notarization secrets. Never commit these.
.env*
*.p12
*.cer
*.mobileprovision
*.provisionprofile

# macOS
.DS_Store
._*
.AppleDouble
.Spotlight-V100
.Trashes

# Editors
.vscode/
.idea/
*.swp
*~
